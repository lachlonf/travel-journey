# Admin login at /admin
ADMIN_PASSWORD=
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Supabase: leave blank to use the local JSON store in .data/ (development only).
# The service role key bypasses row-level security. Server-side only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
